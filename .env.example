# Nusxa oling: cp .env.example .env
PORT=3000
JWT_SECRET=uzun_tasodifiy_matn
# Gmail: Google akkaunt > Xavfsizlik > 2 bosqichli tasdiq > "App passwords" (16 xonali parol)
GMAIL_USER=sizning@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# Ixtiyoriy: MongoDB Atlas ulanish satri (bo'sh bo'lsa data.json ishlatiladi)
MONGO_URL=
# Admin panel uchun email
ADMIN_EMAIL=sizning@gmail.com

# Ixtiyoriy: Telegram bot (@BotFather dan token oling)
TELEGRAM_BOT_TOKEN=

# Ixtiyoriy: Telegram botdagi AI moliyaviy savodxonlik yordamchisi (Google AI Studio)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Render bepul rejasida SMTP yopiq: xat yuborish uchun Brevo (https://brevo.com) API kaliti
BREVO_API_KEY=
# Brevo'da tasdiqlangan yuboruvchi email (Senders bo'limida)
MAIL_FROM=
